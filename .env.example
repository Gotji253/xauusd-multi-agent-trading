# ================================
# Multi-Agent Trading System
# ================================

# ---- Broker ----
# auto | mock | binance | oanda
EXECUTION_MODE=auto
BROKER=binance

# ---- Binance Spot (BTCUSDT) ----
# สร้าง API Key ที่ Binance → API Management
# แนะนำเริ่ม Testnet: https://testnet.binance.vision
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_ENVIRONMENT=testnet
# testnet | live
BINANCE_QTY_SCALE=0.001
# lot_size 1 * 0.001 = 0.001 BTC
# BINANCE_BASE_URL=  # optional, e.g. regional endpoint if needed

SYMBOL=BTCUSDT
RISK_PER_TRADE=0.005
MAX_DAILY_DRAWDOWN=0.03
MAX_OPEN_POSITIONS=1

# ---- OANDA (optional — gold) ----
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENVIRONMENT=practice

# ---- LINE ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

ENVIRONMENT=development
LOG_LEVEL=INFO
