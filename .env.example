# ================================
# XAUUSD Multi-Agent Trading System
# ================================

# MetaTrader 5 Credentials (Demo ก่อนเสมอ)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=   # เว้นว่างได้ถ้า MT5 อยู่ใน PATH ปกติ

# LINE Messaging API / Notify
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # หรือ Group ID

# Trading Parameters (สามารถ override ได้ใน config)
RISK_PER_TRADE=0.0075          # 0.75%
MAX_DAILY_DRAWDOWN=0.035       # 3.5%
MAX_OPEN_POSITIONS=1
SYMBOL=XAUUSD

# Environment
ENVIRONMENT=development        # development | paper | live
LOG_LEVEL=INFO
